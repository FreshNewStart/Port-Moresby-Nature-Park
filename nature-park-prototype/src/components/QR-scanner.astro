<div class="scanner">

  <h2>Scan Animal QR Code</h2>

  <button id="start">Start Scanner</button>

  <div id="reader" style="width:100%; max-width:400px; margin:auto;"></div>

  <p id="status">Idle</p>

</div>

<!-- STABLE FIX -->
<script src="https://cdn.jsdelivr.net/npm/html5-qrcode@latest/html5-qrcode.min.js"></script>

<script is:inline>

  let qr;
  const status = document.getElementById("status");

  document.getElementById("start").addEventListener("click", async () => {

    try {

      status.innerText = "Starting camera...";

      if (!window.Html5Qrcode) {
        throw new Error("Library failed to load");
      }

      qr = new Html5Qrcode("reader");

      const cameras = await Html5Qrcode.getCameras();

      if (!cameras.length) {
        throw new Error("No camera found");
      }

      const cameraId = cameras[0].id;

      await qr.start(
        cameraId,
        {
          fps: 10,
          qrbox: 250
        },
        (decodedText) => {

          status.innerText = decodedText;

          if (decodedText.startsWith("http")) {
            window.location.href = decodedText;
          } else {
            window.location.href = `/animals/${decodedText}`;
          }

        }
      );

    } catch (err) {
      console.error(err);
      status.innerText = "Error: " + err.message;
    }

  });

</script>

<style>

.scanner {
  text-align: center;
  padding: 20px;
}

button {
  padding: 10px 14px;
  margin: 10px;
}

</style>