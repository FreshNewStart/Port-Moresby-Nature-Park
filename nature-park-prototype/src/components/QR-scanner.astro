<div class="scanner-container">

  <h2>Scan Animal QR Code</h2>

  <button id="startScan">Start Scan</button>

  <div id="reader" style="width:100%; max-width:400px; margin:auto;"></div>

  <p id="scan-result">Scanner idle</p>

</div>

<!-- IMPORTANT: Load library via CDN -->
<script src="https://unpkg.com/html5-qrcode"></script>

<script is:inline>

  let scanner;

  const startBtn = document.getElementById("startScan");
  const resultBox = document.getElementById("scan-result");

  startBtn.addEventListener("click", async () => {

    resultBox.innerText = "Starting camera...";

    // Prevent double initialization
    if (scanner) {
      return;
    }

    try {
      scanner = new Html5QrcodeScanner(
        "reader",
        {
          fps: 10,
          qrbox: 250
        },
        false
      );

      scanner.render(onScanSuccess, onScanError);

      console.log("Scanner started");

    } catch (err) {
      console.error(err);
      resultBox.innerText = "Camera failed to start";
    }

  });

  function onScanSuccess(decodedText) {

    resultBox.innerText = "Scanned: " + decodedText;

    // URL QR
    if (decodedText.startsWith("http")) {
      window.location.href = decodedText;
      return;
    }

    // ID QR
    window.location.href = `/animals/${decodedText}`;
  }

  function onScanError(error) {
    // ignore scan noise
  }

</script>

<style>

.scanner-container {
  text-align: center;
  padding: 20px;
  font-family: Arial, sans-serif;
}

button {
  padding: 10px 16px;
  margin: 10px;
  cursor: pointer;
}

#reader {
  margin-top: 10px;
}

</style>